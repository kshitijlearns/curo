# CURO web app. Copy to web/.env.local. Only NEXT_PUBLIC_* values reach the browser, and they
# are public by design: never put a service-role key, an API key or a secret here.

# Supabase Auth (email one-time code). Leave empty to use the backend's local sign-in stub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where `next dev` proxies /api/v1/* (server-side only, not exposed to the browser).
API_ORIGIN=http://127.0.0.1:8000
