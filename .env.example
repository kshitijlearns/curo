# CURO environment (v2: web app). Copy to .env (`make env` does it) and fill in values as keys
# arrive. Secrets are never committed. The web app has its own web/.env.example with the only
# values the browser may see (NEXT_PUBLIC_*).

# --- Backend ---
MOCK_MODE=true                     # true = every outside service uses its mock (fixtures, templates)
APP_ENV=development                # development | test | staging | production
API_BASE_URL=
CRON_SECRET=                       # the scheduler endpoint's shared secret (any long random string)

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=         # backend only, never in the web app
SUPABASE_JWT_SECRET=               # empty in development = a dev-only placeholder is used
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curo   # direct Postgres connection
STORAGE_BUCKET_VIDEOS=reel-videos
STORAGE_BUCKET_THUMBS=reel-thumbs

# Queue (local worker). The Vercel shape (a Postgres queue and a worker endpoint) is deferred:
# docs/DECISIONS.md D200.
REDIS_URL=redis://localhost:6379/0

# Public data (no Instagram API, no Instagram login)
PUBLIC_DATA_PRIMARY=apify          # apify | brightdata
APIFY_TOKEN=
APIFY_PROFILE_ACTOR_ID=
APIFY_REELS_ACTOR_ID=
APIFY_COMMENTS_ACTOR_ID=
APIFY_HASHTAG_ACTOR_ID=
APIFY_WEBHOOK_SECRET=
BRIGHTDATA_API_KEY=                # optional backup vendor

# Collection limits (PLAN_V2 §4.3)
COMMENT_LIMIT=100                  # comments read per reel
INACTIVE_PAUSE_DAYS=14             # collection pauses for creators away this long

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_AGENTS=claude-haiku-5-5   # the Simulator's AI audience

# Google Gemini
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768                  # never mix models or mock/real vectors: tools/reembed.py

# Simulator (PLAN_V2 §4.5)
SIM_AGENTS=1000
SIM_MAX_SECONDS=90

# Plans and credits (PLAN_V2 §4.6)
FREE_PROJECTS=2
FREE_SIMULATIONS=2
FREE_CHAT=10
PRO_PROJECTS=10
PRO_SIMULATIONS=10
PRO_CHAT=100
PRO_PRICE_USD=30
TOPUP_PRICE_USD=1.5
PROJECT_REVISIONS=10
AGENT_CHAT_MESSAGES=10
COST_ALERT_USD=5
PAYMENT_PROVIDER=mock              # mock | razorpay (stub: INTEGRATION.md)
ADMIN_EMAILS=                      # comma-separated: who sees /admin/costs
WEB_URL=curo-sand.vercel.app       # printed on the Creator Recap share card

# Follower Personas (PLAN_V2 v2.2)
PERSONA_MODEL_WEIGHT=0.5           # a persona's score = this × model + the rest × code fit
PERSONA_REFRESH_COMMENTS=150       # new comments since the last build that trigger a rebuild

# Monitoring
SENTRY_DSN_BACKEND=
POSTHOG_KEY=

# --- Per-provider overrides (empty = follow MOCK_MODE) ---
PUBLIC_DATA_PROVIDER=              # mock | apify | brightdata
VIDEO_PROVIDER=                    # mock | gemini
EMBEDDING_PROVIDER=                # mock | gemini
LLM_PROVIDER=                      # mock | claude
STORAGE_PROVIDER=                  # local | supabase
MONITORING_PROVIDER=               # noop | live
AUTH_PROVIDER=                     # local | supabase

# --- Local development ---
# Time-travel anchor. The demo dataset (fixtures/data/meta.json) is built around this
# moment, 12 days before Ganesh Chaturthi 2027; keep it while using the mocks.
# Empty = real time (use that once real providers are connected).
# Move it at runtime with tools/timetravel.py.
FAKE_NOW=2027-08-23T10:00:00+05:30
LOCAL_STORAGE_DIR=.data/storage
DEFAULT_TIMEZONE=Asia/Kolkata
QUEUE_MODE=rq                      # rq | inline | thread (inline: tests; thread: tools/local_stack.py)
CAPTURE_TASK_INPUTS=               # e.g. .data/task-inputs: save AI task inputs for tools/record_contracts.py

# --- Web app (public values only; Next.js reads them from web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
