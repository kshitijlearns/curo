# Public values only: everything here ships inside the app.
# Copy to app/.env if you need to change them.

# Empty = talk to the API on the dev machine Expo is served from (port 8000, same Wi-Fi).
# Set it when the phone can't reach that address, e.g. https://<your-tunnel>.trycloudflare.com
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
