# CURO environment. Copy to .env (`make env` does it) and fill in values as keys arrive.
# Secrets are never committed; real values live in Railway, Supabase and Expo settings.

# --- Backend (Railway) ---
MOCK_MODE=true                     # true = every outside service uses its mock (fixtures, templates)
APP_ENV=development                # development | test | staging | production
API_BASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=         # backend only, never in the app
SUPABASE_JWT_SECRET=               # empty in development = a dev-only placeholder is used
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curo   # direct Postgres connection
STORAGE_BUCKET_VIDEOS=reel-videos
STORAGE_BUCKET_THUMBS=reel-thumbs

# Queue
REDIS_URL=redis://localhost:6379/0

# Public data (no Instagram API)
PUBLIC_DATA_PRIMARY=apify          # apify | brightdata
APIFY_TOKEN=
APIFY_PROFILE_ACTOR_ID=
APIFY_REELS_ACTOR_ID=
APIFY_COMMENTS_ACTOR_ID=
APIFY_HASHTAG_ACTOR_ID=
APIFY_WEBHOOK_SECRET=
BRIGHTDATA_API_KEY=                # optional backup vendor

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Google Gemini
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=
GEMINI_EMBEDDING_MODEL=
EMBEDDING_DIM=768

# Monitoring
SENTRY_DSN_BACKEND=
POSTHOG_KEY=

# --- Per-provider overrides (empty = follow MOCK_MODE) ---
PUBLIC_DATA_PROVIDER=              # mock | apify | brightdata
VIDEO_PROVIDER=                    # mock | gemini
EMBEDDING_PROVIDER=                # mock | gemini
LLM_PROVIDER=                      # mock | claude
STORAGE_PROVIDER=                  # local | supabase
MONITORING_PROVIDER=               # noop | live
AUTH_PROVIDER=                     # local | supabase

# --- Local development ---
# Time-travel anchor. The demo dataset (fixtures/data/meta.json) is built around this
# moment, 12 days before Ganesh Chaturthi 2027; keep it while using the mocks.
# Empty = real time (use that once real providers are connected).
# Move it at runtime with tools/timetravel.py.
FAKE_NOW=2027-08-23T10:00:00+05:30
LOCAL_STORAGE_DIR=.data/storage
DEFAULT_TIMEZONE=Asia/Kolkata
QUEUE_MODE=rq                      # rq | inline (inline runs jobs in-process; tests use it)

# --- Mobile app (Expo, public values only) ---
# Expo reads these from app/.env (see app/.env.example); listed here for completeness.
EXPO_PUBLIC_API_BASE_URL=          # empty = use the dev machine's address from Expo (same Wi-Fi)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
